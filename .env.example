# Dyslexia Assistant Environment Configuration
# Node Environment ('development' or 'production')
NODE_ENV=development

# API Server Port
PORT=3001

# PostgreSQL Database Connection String
# Leave unset or empty to automatically use high-performance in-memory fallback
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dyslexia_db

# Cookie Security (set to true in production HTTPS environments)
COOKIE_SECURE=false

# Trust Proxy (set to 1 when running behind reverse proxy like Nginx or AWS ALB)
TRUST_PROXY=0
