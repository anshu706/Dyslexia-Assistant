# Dyslexia Assistant Environment Configuration
# Node Environment ('development' or 'production')
NODE_ENV=development

# =============================================================================
# Cloud Backend Configuration (Supabase Free Tier - 100% Free, No Credit Card)
# 1. Create a free project at https://supabase.com
# 2. Paste your project URL and public anon key below
# 3. In Supabase Dashboard -> SQL Editor, run supabase/schema.sql
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# API Server Port (for local Node server testing)
PORT=3001

# PostgreSQL Database Connection String
# Leave unset or empty to automatically use high-performance in-memory fallback
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dyslexia_db

# Cookie Security (set to true in production HTTPS environments)
COOKIE_SECURE=false

# Trust Proxy (set to 1 when running behind reverse proxy like Nginx or AWS ALB)
TRUST_PROXY=0
