# ==============================================================================
# Dyslexia Assistant - API Service Multi-stage Dockerfile
# Production-ready, non-root user, minimal alpine footprint, and healthcheck.
# ==============================================================================

# STAGE 1: Builder & Dependency Resolver
FROM node:24.1.0-alpine3.20 AS builder

WORKDIR /app

# Copy dependency specifications
COPY package.json package-lock.json ./

# Install all dependencies including devDependencies for any build steps
RUN npm ci

# STAGE 2: Production Minimal Runtime
FROM node:24.1.0-alpine3.20 AS runner

WORKDIR /app

# Install production dependencies only
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy application server code
COPY server/ ./server/

# Enforce production environment
ENV NODE_ENV=production \
    PORT=3001

# Run as built-in unprivileged node user (UID 1000)
USER node

# Expose API port
EXPOSE 3001

# Container healthcheck for orchestrator (ECS/Kubernetes/Docker)
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:3001/api/health || exit 1

# Start production server
CMD ["node", "server/server.js"]

