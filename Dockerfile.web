# ==============================================================================
# Dyslexia Assistant - Static Frontend Multi-stage Dockerfile
# Builds Vite assets and serves with unprivileged NGINX (non-root UID 101).
# ==============================================================================

# STAGE 1: Frontend Build Stage
FROM node:20.18.0-alpine3.20 AS builder

WORKDIR /app

# Copy dependency specifications
COPY package.json package-lock.json ./
RUN npm ci

# Copy application sources
COPY . .

# Build production bundle to dist/
RUN npm run build

# STAGE 2: Unprivileged NGINX Server
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runner

# Copy custom security-hardened nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose unprivileged web port
EXPOSE 8080

# Healthcheck probe for web server
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
